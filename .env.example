# Google Gemini API config.
# Override order: .env < .env.<profile> < shell.

# AI Studio API key from aistudio.google.com/apikey. Required.
GEMINI_API_KEY=

# Note: fetch timeout is the universal PLURNK_PROVIDER_FETCH_TIMEOUT
# (set in plurnk-service's env). Reasoning is the universal
# PLURNK_REASON; Gemini's OpenAI-compat endpoint translates a positive
# budget into the `reasoning_effort` body field on 2.5+ thinking models.
