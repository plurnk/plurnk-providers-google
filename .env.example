# Google Gemini API config.
# Override order: .env < .env.<profile> < shell.

# AI Studio API key from aistudio.google.com/apikey. Required.
# Alias also accepted: GOOGLE_API_KEY (GEMINI_API_KEY wins when both are set).
GEMINI_API_KEY=

# Note: fetch timeout is the universal PLURNK_PROVIDERS_FETCH_TIMEOUT (set in
# plurnk-service's env). Reasoning is the universal
# PLURNK_PROVIDERS_REASONING_BUDGET; Gemini's OpenAI-compat endpoint translates a
# positive budget into the `reasoning_effort` body field on 2.5+ thinking models.
